NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
LIVE_CHAT_ADMIN_PASSCODE=
GOOGLE_LEADS_WEBHOOK_URL=
GOOGLE_LEADS_WEBHOOK_TOKEN=
GOOGLE_CHAT_WEBHOOK_URL=
# Google Sheets lead capture. Share the spreadsheet with the service account
# email (Editor). Locally set GOOGLE_APPLICATION_CREDENTIALS to the key file
# path; in hosting, paste the key JSON (raw or base64) into
# GOOGLE_SERVICE_ACCOUNT_JSON instead — never commit the key file.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Email notifications for new leads, sent via Resend (resend.com).
# RESEND_FROM must be on a domain verified in the Resend account.
# INQUIRY_EMAIL_TO accepts a comma-separated list of recipients.
RESEND_API_KEY=
RESEND_FROM=Carviondealer <leads@carviondealer.com>
INQUIRY_EMAIL_TO=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
NEXT_PUBLIC_ADMIN_ORIGIN=
# Meta Conversions API: "Bought" on /admin/clients reports a Purchase event.
# Token from Events Manager → dataset → Settings → Conversions API.
# Set META_CAPI_TEST_EVENT_CODE (Events Manager → Test events) to send to the
# test stream only; leave it empty in production.
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v24.0
# Dataset that receives admin "Bought" events (defaults to the original pixel,
# not the browser pixel, which already gets a Purchase for every lead).
META_CAPI_PIXEL_ID=
# Client records for /admin/clients (defaults to .crm-data/clients.json).
CLIENTS_DATA_FILE=
